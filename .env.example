# ShopSphere Environment Variables
# Never commit .env to version control

# Database
DATABASE_URL=jdbc:postgresql://localhost:5432/shopsphere
DATABASE_USERNAME=shopsphere
DATABASE_PASSWORD=secret

# JWT Authentication
JWT_SECRET=shopsphere-jwt-secret-key-minimum-256-bits-long
JWT_EXPIRATION=86400000  # 24 hours in milliseconds

# Service Discovery
EUREKA_SERVER_URL=http://localhost:8761/eureka

# Service URLs (auto-discovered via Eureka at runtime)
AUTH_SERVICE_URL=http://auth-service:8081
PRODUCT_SERVICE_URL=http://product-service:8082
ORDER_SERVICE_URL=http://order-service:8083
PAYMENT_SERVICE_URL=http://payment-service:8084

# Frontend
FRONTEND_URL=http://localhost:5173

# Application
ACTIVE_PROFILES=dev
SERVER_PORT=8080